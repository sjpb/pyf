#!/usr/bin/env python3
"""
Examples:

    $ openstack server show  -c security_groups myserver -f value
    [{'name': 'gpfs'}, {'name': 'default'}]

    This is python data, so we can use eval() to convert it to a python object then extract the unique names:

    $ openstack server show  -c security_groups myserver -f value | ./pyf "sorted(set(tuple(v.values())[0] for v in eval(data)))"
    ['default', 'gpfs']

    Or we can do the same thing with json output:
    $ openstack server show  -c security_groups myserver -f json | ./pyf --json "sorted(set(tuple(v.values())[0] for v in data['security_groups']))"
    ['default', 'gpfs']

"""
import argparse
import json
import fileinput

parser = argparse.ArgumentParser(description="Use python expressions to process stdout")
parser.add_argument("expression", help="Python expression to evaluate on each line of input")

parser.add_argument("--json", "-j", action="store_true", help="Parse input as JSON")
parser.add_argument("--lines", "-l", action="store_true", help="Apply EXPRESSION to each line. Variables: lno, line.")
parser.add_argument("--split", action="store_true", help="Split each record")
parser.add_argument("--quiet", "-q", action="store_true", help="Don't print result of EXPRESSION")
parser.add_argument("--noheader", "-n", action="store_true", help="Ignore first line")
parser.add_argument("file", nargs="?", default="-", help="File to process (default: stdin)")
args = parser.parse_args()
#print('args:', args)
#exit()

with fileinput.input(args.file) as f:
    if args.lines:
        for lno, line in enumerate(f):
            lno = lno + 1
            if args.noheader and lno ==1 :
                continue
            line = line.strip()
            if args.split:
                line = line.split()
            result = eval(args.expression)
            if not args.quiet:
                print(result)
    else:
        data = "".join(list(f)[1:] if args.noheader else f) # TODO: this is terrible, there must be a better way:
        if args.json:
            data = json.loads(data)
        if args.split:
            data = data.split()
        result = eval(args.expression)
        if not args.quiet:
            print(result)
